{
  "oracle": "Python ledger._run_worktree_setup",
  "cases": [
    {
      "name": "success",
      "command": "python -c \"print('setup ok')\"",
      "timeout_seconds": 5,
      "expected": {
        "failed": false
      }
    },
    {
      "name": "nonzero_exit",
      "command": "python -c \"import sys; print('setup failed'); sys.exit(7)\"",
      "timeout_seconds": 5,
      "expected": {
        "failed": true,
        "setupError": {
          "exitCode": 7,
          "timedOut": false,
          "output": "setup failed\n"
        }
      }
    },
    {
      "name": "timeout",
      "command": "python -c \"import time; print('started', flush=True); time.sleep(5)\"",
      "timeout_seconds": 1,
      "expected": {
        "failed": true,
        "setupError": {
          "exitCode": null,
          "timedOut": true,
          "output": "started\n"
        }
      }
    },
    {
      "name": "huge_output",
      "command": "python -c \"import os; os.write(1, b'x' * 4096)\"",
      "timeout_seconds": 5,
      "expected": {
        "failed": false
      }
    },
    {
      "name": "missing_command",
      "command": "purser_missing_setup_command_76136",
      "timeout_seconds": 5,
      "expected": {
        "failed": true,
        "setupError": {
          "exitCode": 1,
          "timedOut": false,
          "output": "<nonempty-shell-error>"
        }
      }
    }
  ]
}
