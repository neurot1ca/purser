{
  "cases": [
    {
      "name": "trusted_copy",
      "trusted": true,
      "copy": "ignored.dat",
      "want": {
        "head": "@HEAD@",
        "snapshot": "@SNAPSHOT@",
        "files": {
          ".gitignore": "ignored.dat\n",
          ".orchestrator/profile.toml": "schema_version = 1\n[worktree]\ncopy = [\"ignored.dat\"]\n",
          "ignored.dat": "ignored\n",
          "new.txt": "untracked\n",
          "tracked.txt": "dirty\n"
        },
        "error": false,
        "cleaned": false,
        "index_matches_snapshot": true
      }
    },
    {
      "name": "untrusted_ignores_copy",
      "trusted": false,
      "copy": "ignored.dat",
      "want": {
        "head": "@HEAD@",
        "snapshot": "@SNAPSHOT@",
        "files": {
          ".gitignore": "ignored.dat\n",
          ".orchestrator/profile.toml": "schema_version = 1\n[worktree]\ncopy = [\"ignored.dat\"]\n",
          "new.txt": "untracked\n",
          "tracked.txt": "dirty\n"
        },
        "error": false,
        "cleaned": false,
        "index_matches_snapshot": true
      }
    },
    {
      "name": "copy_failure_cleans_up",
      "trusted": true,
      "copy": "../escape",
      "want": {
        "head": "",
        "snapshot": "",
        "files": {},
        "error": true,
        "cleaned": true,
        "index_matches_snapshot": false
      }
    }
  ]
}
