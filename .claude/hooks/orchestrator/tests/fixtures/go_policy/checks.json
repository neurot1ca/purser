{
  "oracle": "Python checks.select_checks and run_checks results",
  "definitions": [
    {
      "name": "always",
      "argv": [
        "__PYTHON__",
        "-c",
        "print('ok')"
      ],
      "timeout_seconds": 2
    },
    {
      "name": "src",
      "argv": [
        "__PYTHON__",
        "-c",
        "print('bad'); raise SystemExit(7)"
      ],
      "when": [
        "src/**"
      ],
      "timeout_seconds": 2
    },
    {
      "name": "basename",
      "argv": [
        "__PYTHON__",
        "-c",
        "print('ok')"
      ],
      "when": [
        "*.go"
      ],
      "timeout_seconds": 2
    },
    {
      "name": "docs",
      "argv": [
        "__PYTHON__",
        "-c",
        "print('ok')"
      ],
      "when": [
        "docs/*.md"
      ],
      "timeout_seconds": 2
    },
    {
      "name": "empty",
      "argv": [
        "__PYTHON__",
        "-c",
        "print('ok')"
      ],
      "when": [],
      "timeout_seconds": 2
    }
  ],
  "changed_paths": [
    "./src/main.go",
    "docs/guide.md",
    "elsewhere/readme.txt"
  ],
  "selected": [
    "always",
    "src",
    "basename",
    "docs"
  ],
